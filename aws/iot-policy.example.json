{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "iot:Connect",
      "Resource": "arn:aws:iot:REGION:ACCOUNT_ID:client/autotemp-f01"
    },
    {
      "Effect": "Allow",
      "Action": "iot:Publish",
      "Resource": "arn:aws:iot:REGION:ACCOUNT_ID:topic/autotemp/f01/alerts"
    },
    {
      "Effect": "Allow",
      "Action": "iot:Subscribe",
      "Resource": [
        "arn:aws:iot:REGION:ACCOUNT_ID:topicfilter/autotemp/f01/ack",
        "arn:aws:iot:REGION:ACCOUNT_ID:topicfilter/autotemp/f01/command"
      ]
    },
    {
      "Effect": "Allow",
      "Action": "iot:Receive",
      "Resource": [
        "arn:aws:iot:REGION:ACCOUNT_ID:topic/autotemp/f01/ack",
        "arn:aws:iot:REGION:ACCOUNT_ID:topic/autotemp/f01/command"
      ]
    }
  ]
}